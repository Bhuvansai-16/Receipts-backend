# --- Nebius Token Factory inference (required) ---
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_CLASSIFIER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_TEST_WRITER=nvidia/nemotron-3-super-120b-a12b
# MODEL_TEST_WRITER_STRONG=nvidia/nemotron-3-super-120b-a12b
# MODEL_SCOPE=nvidia/nemotron-3-super-120b-a12b
# MODEL_JUDGE=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Sandbox provider: contree (Token Factory Sandboxes) | daytona (stopgap until Sandboxes beta access) ---
SANDBOX_PROVIDER=contree
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api

# --- Token Factory Sandboxes ---
CONTREE_PROJECT=
# CONTREE_TOKEN=            # only if sandbox key differs from NEBIUS_API_KEY
# CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
# SANDBOX_TIMEOUT_S=900
# SANDBOX_MAX_CONCURRENCY=20

# --- LangSmith (tracing turns on automatically when the key is set) ---
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=receipts

# --- Tavily (docs search for the test writer) ---
TAVILY_API_KEY=

# --- Verdict knobs ---
# MAX_TEST_ATTEMPTS=5
# VERDICT_RUNS=3

# --- Neon Postgres (Neon Console > Connect). Pooled for the app, direct for migrations ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Neon Console > Auth > Auth URL) ---
NEON_AUTH_URL=

# --- Where the UI and this API run ---
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
# COOKIE_DOMAIN=.example.com   # only if other subdomains must see the auth cookies

# --- Limits ---
# MAX_ACTIVE_RUNS=2
# RUNS_PER_DAY=20
# GLOBAL_RUNS_PER_DAY=60           # all users together in 24 hours: caps sandbox and model spend
# ALLOWED_GITHUB_ACCOUNTS=         # comma separated; when set, webhook auto-checks run only on these accounts

# --- GitHub App (README: "GitHub App") ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY=      # alternative: the PEM with newlines written as \n
GITHUB_WEBHOOK_SECRET=
